/* MIND LAB — structural redesign */
:root{
  --bg:#080a10;--panel:#111620;--panel2:#171e2b;--line:#30394c;
  --text:#edf2fb;--muted:#929db1;--red:#ff4964;--cyan:#76e8f1;
  --gold:#e8c17c;--green:#77e7b4;--shadow:0 22px 65px #0009
}
body{
  background:
    radial-gradient(ellipse at 48% 0%,#242438 0,transparent 44%),
    radial-gradient(ellipse at 95% 80%,#151b29 0,transparent 40%),var(--bg)
}
.topbar{padding:0 clamp(14px,2.5vw,34px)}
.tools-toggle{border-color:#6ce7f255;color:#c5f8fb}
.layout{grid-template-columns:218px minmax(0,1fr);max-width:none}
.sidebar{padding:24px 13px 28px 18px;background:#0b0e16eF}
.main{padding:clamp(17px,2.2vw,32px);min-width:0}
.hero{
  min-height:205px;margin:12px 0 18px;border-radius:8px;
  background:#111722;border-color:#ffffff20
}
.hero:after{
  background:linear-gradient(90deg,#090b12f4 0%,#090b12d9 43%,#090b1260 100%),
  linear-gradient(0deg,#090b12 0%,transparent 55%)
}
.hero-content{padding:25px clamp(22px,3vw,38px);max-width:800px}
.hero h1{font-size:clamp(28px,3.2vw,43px);margin:10px 0 9px;letter-spacing:-.04em}
.hero p{font-size:13px;max-width:670px;margin-bottom:13px}
.hero-meta{margin-top:12px}
.chapter-kicker{font-size:10px}
#beginBtn{padding:10px 14px}
.content-grid{display:block;position:relative;min-width:0}
.content-grid>.panel{width:100%}
.content-grid>.panel .panel-head{background:linear-gradient(90deg,#171d2a,#111620)}
.board{
  position:relative;isolation:isolate;
  grid-template-columns:repeat(auto-fill,minmax(min(100%,218px),1fr));
  gap:17px;padding:22px;
  min-height:340px;
  background-color:#25201d;
  background-image:
    radial-gradient(ellipse at 20% 15%,#7b5b3b18,transparent 35%),
    radial-gradient(ellipse at 80% 75%,#0005,transparent 42%),
    radial-gradient(#ffffff0a 1px,transparent 1px);
  background-size:auto,auto,17px 17px;
  border-top:1px solid #4a3c31;
}
.board:before{
  content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.32;
  background:
    linear-gradient(24deg,transparent 0 31%,#a43a4655 31.12%,#a43a4655 31.3%,transparent 31.42%),
    linear-gradient(151deg,transparent 0 54%,#a43a4650 54.12%,#a43a4650 54.3%,transparent 54.42%),
    linear-gradient(6deg,transparent 0 72%,#a43a4650 72.12%,#a43a4650 72.3%,transparent 72.42%);
}
.clue{
  z-index:1;overflow:visible;border-radius:3px;
  background:linear-gradient(145deg,#f1eee6,#d9d3c8);
  color:#1b2028;border:1px solid #ffffff80;
  box-shadow:0 7px 15px #0007,0 1px 0 #fff9 inset;
  transform:rotate(var(--tilt,0deg));
  transition:transform .2s,border-color .2s,box-shadow .2s
}
.clue:nth-child(3n+1){--tilt:-1.2deg}
.clue:nth-child(3n+2){--tilt:.8deg}
.clue:nth-child(3n){--tilt:-.35deg}
.clue:hover{z-index:3;transform:translateY(-4px) rotate(0);border-color:#fff;box-shadow:0 15px 28px #0009}
.clue.found{border-color:#77e7b4}
.clue-img{height:132px;background-color:#272c35}
.clue-img:after{background:linear-gradient(0deg,#11162030,transparent 60%),linear-gradient(90deg,#080a1044,transparent)}
.clue-index{background:#101620ed;color:#91f0f6}
.clue-copy{padding:11px 12px 13px}
.clue-type{color:#9c3040;font-size:9px}
.clue h3{font-family:Georgia,serif;font-size:15px;color:#171d27;margin:5px 0}
.clue p{color:#5f6874}
.count{border-radius:3px}
.panel{border-radius:7px}
.panel-head{padding:15px 17px}
.panel-title{letter-spacing:.08em}
.rightcol{
  position:fixed;z-index:24;top:68px;right:0;bottom:0;
  width:min(340px,calc(100vw - 24px));padding:17px;
  display:grid;grid-template-rows:auto minmax(180px,1fr);gap:14px;
  overflow-y:auto;background:#090c14f5;
  border-left:1px solid #ffffff20;box-shadow:-24px 0 70px #0008;
  backdrop-filter:blur(20px);
  transform:translateX(0);transition:transform .28s ease
}
.rightcol.drawer-closed{transform:translateX(105%);pointer-events:none}
.rightcol .panel{background:linear-gradient(145deg,#151b28,#0d1119)}
.rightcol .suspects{gap:8px;padding:11px}
.suspect{background:#0e131d;border-color:#30394c}
.avatar{width:48px;height:52px;border:1px solid #ffffff20;border-radius:3px}
.suspect strong{font-size:12px}
.log{padding:12px 15px}
.decision{margin-top:17px}
.decision .panel-head{background:#121824}
.decision-body{padding:clamp(16px,2vw,24px)}
.decision h2{font-size:clamp(18px,2vw,24px)}
.option{border-radius:4px}
.btn-primary,.btn-secondary,.iconbtn,.ghostbtn{border-radius:4px}
.btn-primary{box-shadow:0 7px 22px #ff425d20}
.final-report{margin-bottom:20px}
.footer{padding-bottom:8px}
.modal{z-index:40}
.modal-card{border-radius:7px}
@media(min-width:1300px){
  .board{grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:19px;padding:25px}
  .clue-img{height:145px}
}
@media(max-width:900px){
  .layout{grid-template-columns:180px minmax(0,1fr)}
  .sidebar{padding-left:12px}
  .main{padding:17px}
  .rightcol{top:68px}
}
@media(max-width:700px){
  .topbar{height:58px;padding:0 10px;gap:7px}
  .brand{gap:8px}
  .brand-mark{width:26px;height:26px}
  .tools-toggle{font-size:10px;padding:8px 9px}
  #soundBtn{font-size:10px;padding:8px}
  #resetBtn{padding:8px 10px}
  .layout{display:block}
  .sidebar{padding:9px 10px;top:58px}
  .main{padding:14px 10px 26px}
  .hero{min-height:0}
  .hero-content{padding:22px 17px}
  .hero h1{font-size:34px}
  .hero p{font-size:12px}
  .hero-meta{gap:6px}
  .tag{font-size:8px;padding:5px 6px}
  .board{grid-template-columns:repeat(2,minmax(0,1fr));padding:13px;gap:12px;min-height:0}
  .clue-img{height:105px}
  .clue-copy{padding:9px}
  .clue h3{font-size:13px}
  .rightcol{top:58px;padding:12px;width:min(340px,calc(100vw - 18px))}
  .rightcol .panel-head{padding:12px}
  .decision-body{padding:14px}
}
@media(max-width:390px){
  .brand{font-size:10px}
  .tools-toggle{font-size:9px;padding:7px}
  .board{padding:9px;gap:9px}
  .clue-img{height:88px}
}

