let state={stage:0,found:[],choice:null,submitted:[],xp:0,started:false,sound:false,logs:[],ended:false};let activeClue=null,audioCtx=null;const $=id=>document.getElementById(id);const safeGet=()=>{try{const s=localStorage.getItem('mindlab017');if(s){const p=JSON.parse(s);if(p&&Array.isArray(p.found)&&typeof p.stage==='number')return {...state,...p,sound:false}}}catch(e){}return null};const save=()=>{try{localStorage.setItem('mindlab017',JSON.stringify({...state,sound:false}))}catch(e){}};
