function toast(s){$('toast').textContent=s;$('toast').classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>$('toast').classList.remove('show'),2400)}function log(s){const t=new Date().toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});state.logs.unshift({t,s});state.logs=state.logs.slice(0,5);$('log').innerHTML=state.logs.map(x=>`<div class="logline"><span class="logtime">${x.t}</span><span>${x.s}</span></div>`).join('');save()}
function renderBoard(){const list=clues.filter(c=>c.stage===state.stage);$('board').innerHTML=list.map(c=>{const i=clues.indexOf(c),found=state.found.includes(i);return `<button class="clue ${found?'found':''}" data-clue="${i}"><div class="clue-img" style="background-image:url('${c.image}')"><span class="clue-index">E-${String(i+1).padStart(2,'0')}</span>${found?'<span class="foundmark">✓</span>':''}</div><div class="clue-copy"><div class="clue-type">${c.type}</div><h3>${c.title}</h3><p>${found?'МАТЕРИАЛ ИЗУЧЕН':'Открыть материал ↗'}</p></div></button>`}).join('');document.querySelectorAll('[data-clue]').forEach(b=>b.addEventListener('click',()=>openClue(+b.dataset.clue)));$('clueCount').textContent=String(state.found.length).padStart(2,'0')+' / 12 ИЗУЧЕНО';$('progressText').textContent=state.found.length+' / 12';$('progressBar').style.width=(state.found.length/12*100)+'%';$('xpSide').textContent=String(state.xp).padStart(3,'0')+' XP'}
function renderStage(){const s=stages[state.stage];$('chapterKicker').textContent=s.kicker;$('heroTitle').innerHTML=s.title;$('heroDesc').textContent=s.desc;$('heroBg').style.backgroundImage=`url('${s.bg}')`;$('decisionStep').textContent=`ЭТАП 0${state.stage+1} / 04`;$('questionTitle').textContent=s.question;$('questionText').textContent=s.prompt;$('options').innerHTML=s.options.map((o,i)=>`<button class="option ${state.choice===i?'selected':''}" data-choice="${i}" ${state.submitted[state.stage]!==undefined?'disabled':''}><b>${o[0]}</b><span>${o[1]}</span></button>`).join('');document.querySelectorAll('[data-choice]').forEach(b=>b.addEventListener('click',()=>{if(state.submitted[state.stage]!==undefined)return;state.choice=+b.dataset.choice;document.querySelectorAll('[data-choice]').forEach(x=>x.classList.toggle('selected',x===b));beep(500,.05)}));$('feedback').classList.remove('show');$('feedback').textContent='';$('submitBtn').disabled=state.submitted[state.stage]!==undefined;$('submitBtn').textContent=state.submitted[state.stage]!==undefined?'ГИПОТЕЗА ЗАФИКСИРОВАНА ✓':'ЗАФИКСИРОВАТЬ ГИПОТЕЗУ ↗';$('nextBtn').disabled=state.submitted[state.stage]===undefined;$('nextBtn').textContent=state.stage===3?'СФОРМИРОВАТЬ ОТЧЁТ →':'СЛЕДУЮЩИЙ ЭТАП →';document.querySelectorAll('[data-stage]').forEach(b=>{const n=+b.dataset.stage;b.classList.toggle('active',n===state.stage);b.classList.toggle('done',state.submitted[n]!==undefined)});renderBoard();$('finalReport').classList.toggle('show',state.ended)}
function openClue(i){activeClue=i;const c=clues[i];$('modalArt').style.backgroundImage=`url('${c.image}')`;$('modalType').textContent=c.type+' / E-'+String(i+1).padStart(2,'0');$('modalTitle').textContent=c.title;$('modalDesc').textContent=c.desc;$('modalEvidence').textContent=c.evidence;$('markClueBtn').textContent=state.found.includes(i)?'УЖЕ ИЗУЧЕНО ✓':'ОТМЕТИТЬ ИЗУЧЕННЫМ ✓';$('clueModal').classList.add('open');beep(420,.08)}function closeClue(){$('clueModal').classList.remove('open');activeClue=null}function markClue(){if(activeClue===null)return;const c=clues[activeClue];if(!state.found.includes(activeClue)){state.found.push(activeClue);state.xp+=10;log('Изучен материал: '+c.title+'. +10 XP');toast('Улика добавлена в аналитическое досье · +10 XP');beep(780,.1);renderBoard()}else toast('Материал уже отмечен как изученный');closeClue();save()}
function start(){state.started=true;$('investigation').scrollIntoView({behavior:'smooth',block:'start'});log('Осмотр начат. Аналитик получил доступ к архиву.');beep(600,.1);save()}function submit(){if(state.submitted[state.stage]!==undefined){toast('Гипотеза уже зафиксирована');return}if(state.choice===null){toast('Сначала выбери рабочую гипотезу');beep(180,.1,'square');return}const s=stages[state.stage],correct=state.choice===s.correct;state.submitted[state.stage]=state.choice;state.xp+=correct?25:5;$('feedback').textContent=s.feedback[state.choice]+(correct?' Версия согласуется с ключевыми материалами. +25 XP':' Гипотеза сохранена в журнале. +5 XP');$('feedback').classList.add('show');$('submitBtn').disabled=true;$('submitBtn').textContent='ГИПОТЕЗА ЗАФИКСИРОВАНА ✓';$('nextBtn').disabled=false;document.querySelectorAll('[data-choice]').forEach(b=>b.disabled=true);log('Этап '+(state.stage+1)+': зафиксирована версия «'+s.options[state.choice][0]+'».');beep(correct?850:350,.15);if(state.stage===3){$('nextBtn').textContent='СФОРМИРОВАТЬ ОТЧЁТ →'}save();renderBoard();$('xpSide').textContent=String(state.xp).padStart(3,'0')+' XP'}function next(){if(state.submitted[state.stage]===undefined)return;if(state.stage<3){toast(stages[state.stage].next);state.stage++;state.choice=null;state.started=true;renderStage();log('Открыт этап '+(state.stage+1)+': '+stages[state.stage].kicker.split('—')[1].trim()+'.');$('investigation').scrollIntoView({behavior:'smooth',block:'start'});beep(560,.08);save()}else finish()}
function finish(){state.ended=true;const count=state.found.length,correct=state.submitted.reduce((n,v,i)=>n+(v===stages[i].correct?1:0),0);$('finalTitle').textContent=correct>=3?'РЕКОНСТРУКЦИЯ ПОДТВЕРЖДЕНА':'ДЕЛО ОСТАЁТСЯ ОТКРЫТЫМ';$('finalText').textContent='Наиболее обоснованная версия: Vale инсценировал исчезновение, чтобы выиграть время и защитить материалы об утечке данных. Пустое кресло, искусственно подготовленная вентиляционная решётка и несинхронизированные часы показывают, что сцена была поставлена. Whitmore, вероятно, знала о временном окне, но доказательств её соучастия недостаточно. Mercer имел технический доступ, однако сам по себе доступ не устанавливает вину. '+(correct>=3?'Ты последовательно отличал доказательства от предположений и собрал убедительную версию.':'Часть гипотез увела расследование в сторону. В отчёте оставлены только выводы, которые поддерживаются материалами.');$('finalXP').textContent=state.xp;$('finalClues').textContent=count+'/12';$('finalRank').textContent=state.xp>=150?'S':state.xp>=100?'A':state.xp>=60?'B':'C';$('finalReport').classList.add('show');log('Подготовлен итоговый аналитический отчёт.');save();$('finalReport').scrollIntoView({behavior:'smooth',block:'center'});beep(700,.12);setTimeout(()=>beep(900,.16),140)}function reset(){if(!confirm('Начать дело заново? Текущий прогресс будет сброшен.'))return;state={stage:0,found:[],choice:null,submitted:[],xp:0,started:false,sound:state.sound,logs:[],ended:false};try{localStorage.removeItem('mindlab017')}catch(e){}$('finalReport').classList.remove('show');renderStage();log('Новое расследование открыто.');window.scrollTo({top:0,behavior:'smooth'});toast('Дело сброшено. Начинаем заново.')}function setStage(n){if(n>state.stage&&state.submitted[state.stage]===undefined){toast('Сначала зафиксируй гипотезу текущего этапа');return}if(n>state.stage+1){toast('Сначала пройди предыдущий этап');return}if(n<state.stage){state.stage=n;state.choice=state.submitted[n]===undefined?null:state.submitted[n];renderStage();$('investigation').scrollIntoView({behavior:'smooth',block:'start'});beep(430,.06)}}
$('toolsBtn').addEventListener('click',()=>{const drawer=$('rightDrawer');const closed=drawer.classList.toggle('drawer-closed');$('toolsBtn').setAttribute('aria-expanded',String(!closed));$('toolsBtn').textContent=closed?'☷ ИНСТРУМЕНТЫ':'× ЗАКРЫТЬ ПАНЕЛЬ';beep(closed?380:540,.06)});document.addEventListener('keydown',e=>{if(e.key==='Escape'){$('rightDrawer').classList.add('drawer-closed');$('toolsBtn').setAttribute('aria-expanded','false');$('toolsBtn').textContent='☷ ИНСТРУМЕНТЫ'}});$('beginBtn').addEventListener('click',start);$('submitBtn').addEventListener('click',submit);$('nextBtn').addEventListener('click',next);$('markClueBtn').addEventListener('click',markClue);$('closeModal').addEventListener('click',closeClue);$('closeModal2').addEventListener('click',closeClue);$('clueModal').addEventListener('click',e=>{if(e.target===$('clueModal'))closeClue()});$('resetBtn').addEventListener('click',reset);$('restartBtn').addEventListener('click',reset);$('navlist').addEventListener('click',e=>{const b=e.target.closest('[data-stage]');if(b)setStage(+b.dataset.stage)});$('soundBtn').addEventListener('click',()=>{state.sound=!state.sound;$('soundBtn').textContent=state.sound?'♫ ЗВУК: ВКЛ':'♫ ЗВУК: ВЫКЛ';if(state.sound){beep(660,.09);toast('Звуковые сигналы включены')}else toast('Звуковые сигналы выключены');save()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeClue()});const loaded=safeGet();if(loaded)state=loaded;state.sound=false;$('soundBtn').textContent='♫ ЗВУК: ВЫКЛ';renderStage();if(state.logs.length)$('log').innerHTML=state.logs.map(x=>`<div class="logline"><span class="logtime">${x.t}</span><span>${x.s}</span></div>`).join('');if(state.ended)$('finalReport').classList.add('show');
})();
</script></body></html>
